# ==============================================================================
# WVP-PRO Docker 部署环境变量（docker-compose 多容器方案）
# ------------------------------------------------------------------------------
# 使用：按需修改本文件后执行  docker compose up -d  生效
# 提示：本文件会被 docker compose 与目录下的 docker-compose 文件自动读取
# ==============================================================================

# ------------------------------ 网络（部署前必须修改） ------------------------------
# 【必须修改】宿主机 IP：摄像机/SIP 平台能够访问到的本机 IP（一般为服务器网卡 IP）
# 不能填 127.0.0.1 / localhost，否则浏览器播放和设备回放都会失败
Stream_IP=192.168.1.100
# 【必须修改】SDP 中媒体收流地址使用的 IP，一般与 Stream_IP 相同
SDP_IP=192.168.1.100
# 【可选】前端页面展示的 SIP 服务器地址，一般与 Stream_IP 相同
SIP_ShowIP=192.168.1.100

# ------------------------------ 国标 SIP 参数 ------------------------------
# SIP 服务器编码（国标 20 位：前 10 位域编码 + 8 位中心编码 + 2 位行业编码）
SIP_Id=34020000002000000001
# SIP 域编码（国标 10 位）
SIP_Domain=3402000000
# 【必须修改】设备默认注册密码
SIP_Password=12345678
# SIP 信令监听端口（容器内外一致）
SIP_Port=5060

# ------------------------------ wvp 镜像构建（由源码构建） ------------------------------
# 源码仓库（默认 gitee，国内速度快；也可改为 https://github.com/648540858/wvp-GB28181-pro.git）
WVP_GIT_URL=https://gitee.com/pan648540858/wvp-GB28181-pro.git
# 源码分支或标签（master 即当前 v3.0.0 代码）
WVP_GIT_REF=master
# 构建产物镜像名:标签
WVP_IMAGE=wvp-pro:3.0.0

# ------------------------------ MySQL（内网服务，不对外暴露） ------------------------------
# root 密码
MYSQL_ROOT_PASSWORD=wvp_root_123456
# 业务数据库名（初始化 SQL 会建表，无需建库）
MYSQL_DATABASE=wvp
# 业务账号
MYSQL_USER=wvp
MYSQL_PASSWORD=wvp_123456

# ------------------------------ Redis（内网服务，不对外暴露） ------------------------------
REDIS_PWD=wvp_redis_123456

# ------------------------------ ZLM API 密钥 ------------------------------
# 【重要】必须与 config/zlm-config.ini 中 [api] secret 完全一致
ZLM_SERCERT=wvppro-zlm-3.0.0-9f3a7c2e5b1d4068a1c9