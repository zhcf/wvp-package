; ZLMediaKit 配置文件【模板】（WVP-PRO Windows 原生运行专用）
; ------------------------------------------------------------------------------
; 说明：
;   1. 本文件是「模板」，由 windows\start.ps1 启动时替换 @XX@ 占位符后生成：
;        runtime\zlm\config.ini
;      请勿直接修改本文件用于运行；需要长期调参请修改运行目录下生成的配置。
;   2. 编码要求：UTF-8 无 BOM（含 BOM 会导致 ZLM 解析首个节名失败）。
;   3. 相对路径基准：ZLM 运行目录 runtime\zlm\（. 即该目录）。
;   4. ffmpeg：截图/转推功能需要 ffmpeg.exe，未放置时相关功能不可用，不影响主流程；
;      下载 win64 构建后把 ffmpeg.exe 放到 runtime\zlm\ 目录即可。
;   5. 占位符与 start.ps1 顶部配置一一对应：
;        @ZLM_SECRET@     ZLM API 密钥（与 WVP application.yml media.secret 一致）
;        @MEDIA_ID@       媒体服务器 ID（与 WVP media.id 一致）
;        @WVP_PORT@       WVP 服务端口（[hook] 回调地址端口）
;        @ZLM_HTTP_PORT@  [http] 端口（浏览器播流/API）
;        @ZLM_RTSP_PORT@  [rtsp] 端口
;        @ZLM_RTMP_PORT@  [rtmp] 端口
;        @ZLM_RTP_PORT@   [rtp_proxy] 单端口收流端口
;        @ZLM_RTC_PORT@   [rtc] 端口（udp/tcp）
; ------------------------------------------------------------------------------
;auto-generated by mINI class {

[api]
apiDebug=1
defaultSnap=./www/logo.png
downloadRoot=./www;
secret=@ZLM_SECRET@
snapRoot=./www/snap/

[cluster]
origin_url=
retry_count=3
timeout_sec=15

[ffmpeg]
bin=./ffmpeg.exe
cmd=%s -re -i %s -c:a aac -strict -2 -ar 44100 -ab 48k -c:v libx264 -f flv %s
log=./ffmpeg/ffmpeg.log
restart_sec=0
snap=%s -rtsp_transport tcp -i %s -y -f mjpeg -frames:v 1 %s

[general]
broadcast_player_count_changed=0
; Windows 构建通常不含 CUDA，保持 0（使用 NVIDIA 硬解码时可改为 1）
check_nvidia_dev=0
enableVhost=0
enable_ffmpeg_log=0
flowThreshold=1024
; 全 IPv4 监听（本方案所有组件均以 127.0.0.1/IPv4 通信）
listen_ip=0.0.0.0
maxStreamWaitMS=15000
mediaServerId=@MEDIA_ID@
mergeWriteMS=0
resetWhenRePlay=1
streamNoneReaderDelayMS=20000
unready_frame_cache=100
wait_add_track_ms=3000
wait_audio_track_data_ms=1000
wait_track_ready_ms=10000

[hls]
broadcastRecordTs=0
deleteDelaySec=10
fastRegister=0
fileBufSize=65536
segDelay=0
segDur=2
segKeep=0
segNum=3
segRetain=5

[hook]
alive_interval=10.0
enable=1
on_flow_report=
on_http_access=
on_play=http://127.0.0.1:@WVP_PORT@/index/hook/on_play
on_publish=http://127.0.0.1:@WVP_PORT@/index/hook/on_publish
on_record_mp4=http://127.0.0.1:@WVP_PORT@/index/hook/on_record_mp4
on_record_ts=
on_rtp_server_timeout=http://127.0.0.1:@WVP_PORT@/index/hook/on_rtp_server_timeout
on_rtsp_auth=
on_rtsp_realm=
on_send_rtp_stopped=http://127.0.0.1:@WVP_PORT@/index/hook/on_send_rtp_stopped
on_server_exited=
on_server_keepalive=http://127.0.0.1:@WVP_PORT@/index/hook/on_server_keepalive
on_server_started=http://127.0.0.1:@WVP_PORT@/index/hook/on_server_started
on_shell_login=
on_stream_changed=http://127.0.0.1:@WVP_PORT@/index/hook/on_stream_changed
on_stream_none_reader=http://127.0.0.1:@WVP_PORT@/index/hook/on_stream_none_reader
on_stream_not_found=http://127.0.0.1:@WVP_PORT@/index/hook/on_stream_not_found
retry=1
retry_delay=3.0
stream_changed_schemas=rtsp/rtmp/fmp4/ts/hls/hls.fmp4
timeoutSec=30

[http]
allow_cross_domains=1
allow_ip_range=
charSet=utf-8
dirMenu=1
forbidCacheSuffix=
forwarded_ip_header=
keepAliveSecond=30
maxReqSize=40960
notFound=<html><head><title>404 Not Found</title></head><body bgcolor="white"><center><h1>您访问的资源不存在！</h1></center><hr><center>ZLMediaKit</center></body></html>
port=@ZLM_HTTP_PORT@
rootPath=./www
sendBufSize=65536
sslport=0
virtualPath=

[multicast]
addrMax=239.255.255.255
addrMin=239.0.0.0
udpTTL=64

[protocol]
add_mute_audio=1
auto_close=0
continue_push_ms=3000
enable_audio=1
enable_fmp4=1
enable_hls=0
enable_hls_fmp4=0
enable_mp4=0
enable_rtmp=1
enable_rtsp=1
enable_ts=1
fmp4_demand=0
hls_demand=0
hls_save_path=./www
modify_stamp=2
mp4_as_player=0
mp4_max_second=3600
mp4_save_path=./www
paced_sender_ms=0
rtmp_demand=0
rtsp_demand=0
ts_demand=0

[record]
appName=record
enableFmp4=1
fastStart=0
fileBufSize=65536
fileRepeat=0
sampleMS=500

[rtc]
bfilter=0
datachannel_echo=0
externIP=
maxRtpCacheMS=5000
maxRtpCacheSize=2048
max_bitrate=0
min_bitrate=0
nackIntervalRatio=1.0
nackMaxCount=15
nackMaxMS=3000
nackMaxSize=2048
nackRtpSize=8
port=@ZLM_RTC_PORT@
preferredCodecA=PCMA,PCMU,opus,mpeg4-generic
preferredCodecV=H264,H265,AV1,VP9,VP8
rembBitRate=0
start_bitrate=0
tcpPort=@ZLM_RTC_PORT@
timeoutSec=30

[rtmp]
directProxy=1
enhanced=0
handshakeSecond=15
keepAliveSecond=15
port=@ZLM_RTMP_PORT@
sslport=0

[rtp]
audioMtuSize=600
h264_stap_a=1
lowLatency=0
rtpMaxSize=10
videoMtuSize=1400

[rtp_proxy]
dumpDir=
gop_cache=1
h264_pt=98
h265_pt=99
merge_frame=1
opus_pt=100
port=@ZLM_RTP_PORT@
port_range=30000-30500
ps_pt=96
rtp_g711_dur_ms=100
timeoutSec=15
udp_recv_socket_buffer=4194304

[rtsp]
authBasic=0
directProxy=1
handshakeSecond=15
keepAliveSecond=15
lowLatency=0
port=@ZLM_RTSP_PORT@
rtpTransportType=-1
sslport=0

[shell]
maxReqSize=1024
port=0

[srt]
latencyMul=4
passPhrase=
pktBufSize=8192
port=9000
timeoutSec=5

; } ---